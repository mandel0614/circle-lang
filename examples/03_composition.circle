cell ResilientNavigator {
  input attractant;
  input hazard;
  state H in [0, 1];
  migrate toward attractant;
  avoid hazard;
  maintain H in [0.40, 0.60];
  budget 0.75;
  require target_occupancy >= 0.80;
  require forbidden_entry_fraction <= 0.10;
  require band_occupancy >= 0.80;
  require unsafe_state_fraction <= 0.05;
  require recovery_fraction >= 0.80;
  require budget_violations == 0;
}
